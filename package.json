{
  "name": "@robuust-digital/eslint-config",
  "version": "0.5.0",
  "description": "Robuust shared ESLint flat config with stylistic defaults",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./typescript": "./typescript.js",
    "./vue": "./vue.js"
  },
  "files": [
    "index.js",
    "typescript.js",
    "vue.js",
    "CHANGELOG.md",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslintconfig",
    "flat-config",
    "stylistic",
    "airbnb"
  ],
  "author": "Robuust",
  "license": "MIT",
  "peerDependencies": {
    "eslint": ">=10",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-vue": "^10.9.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.5.0",
    "typescript-eslint": "^8.59.4",
    "vue-eslint-parser": "^10.4.0"
  },
  "devDependencies": {
    "eslint": "^10.0.1",
    "typescript": "6.0.3"
  }
}
