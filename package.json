{
  "name": "@robuust-digital/eslint-config",
  "version": "0.6.0",
  "description": "Robuust shared ESLint flat config with stylistic defaults",
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./typescript": {
      "types": "./typescript.d.ts",
      "default": "./typescript.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "typescript.js",
    "typescript.d.ts",
    "vue.js",
    "vue.d.ts",
    "CHANGELOG.md",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslintconfig",
    "flat-config",
    "stylistic",
    "airbnb"
  ],
  "author": "Robuust",
  "license": "MIT",
  "scripts": {
    "test:types": "tsc -p tests/tsconfig.json"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "typescript": ">=5.3.0 <6.1.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "typescript": "6.0.3"
  }
}
